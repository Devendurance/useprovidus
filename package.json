{
  "name": "celo-hackathon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npx tsx lib/db/migrate.ts",
    "test:wallet-helpers": "npx --yes tsx lib/wallet/self-check.ts",
    "test:money-helpers": "npx --yes tsx lib/money/self-check.ts",
    "test:recipient-helpers": "npx --yes tsx lib/paycrest/recipient-self-check.ts",
    "test:order-helpers": "npx --yes tsx lib/paycrest/order-self-check.ts",
    "test:order-route": "npx --yes tsx lib/paycrest/server/create-order-route-self-check.ts",
    "test:attribution": "npx --yes tsx lib/celo/attribution-self-check.ts",
    "test:persistence": "npx --yes tsx lib/transactions/persistence-self-check.ts",
    "test:reconciliation": "npx --yes tsx lib/paycrest/server/reconciliation-self-check.ts",
    "test:recovery-security": "npx --yes tsx lib/transactions/recovery-security-self-check.ts",
    "test:all": "npm run test:wallet-helpers && npm run test:money-helpers && npm run test:recipient-helpers && npm run test:order-helpers && npm run test:order-route && npm run test:attribution && npm run test:persistence && npm run test:reconciliation && npm run test:recovery-security"
  },
  "dependencies": {
    "@celo/attribution-tags": "^0.3.0",
    "@gsap/react": "^2.1.2",
    "@tanstack/react-query": "^5.101.4",
    "drizzle-orm": "^0.45.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "viem": "^2.55.10",
    "wagmi": "^3.7.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
