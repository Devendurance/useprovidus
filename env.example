# Server-only Paycrest (never use NEXT_PUBLIC_ for these)
PAYCREST_API_KEY=
PAYCREST_BASE_URL=https://api.paycrest.io/v2
PAYCREST_API_SECRET=

# Server-only ClubKonnect (never use NEXT_PUBLIC_ for these)
CLUBKONNECT_USER_ID=
CLUBKONNECT_API_KEY=
CLUBKONNECT_BASE_URL=https://www.nellobytesystems.com

# Server-only conversational assistant model (never use NEXT_PUBLIC_ for these)
DEEPSEEK_API_KEY=
# Optional non-secret defaults (omit to use https://api.deepseek.com and deepseek-chat)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Server-only operating settlement account (never use NEXT_PUBLIC_ for these)
# Destination bank account for airtime settlement; missing or invalid values fail closed.
PROVIDUS_SETTLEMENT_INSTITUTION_CODE=
PROVIDUS_SETTLEMENT_ACCOUNT_NUMBER=
PROVIDUS_SETTLEMENT_ACCOUNT_NAME=
PROVIDUS_SETTLEMENT_MEMO="Providus utility settlement"

# Server-only database (Supabase Postgres)
DATABASE_URL=

# Optional Celo RPC override (defaults to https://forno.celo.org)
CELO_RPC_URL=https://forno.celo.org

# Celo mainnet ERC-8021 attribution tag (Agents at Work hackathon)
NEXT_PUBLIC_CELO_ATTRIBUTION_TAG=celo_8190b99392a2
